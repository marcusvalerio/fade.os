NEXT_PUBLIC_SUPABASE_URL=https://xaxszgyvapvzwensbjjq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_AxEYV0Jld8trM-7ng4qFTw_6JonLvCt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (docs/observabilidade.md). O DSN é público por desenho.
NEXT_PUBLIC_SENTRY_DSN=
# Só no build da Vercel (tipo sensitive) — sobe source maps. Nunca no navegador.
SENTRY_AUTH_TOKEN=
# Só no servidor — leitura para o Admin > Saúde (event:read, project:read).
SENTRY_API_TOKEN=
# Só no servidor — Client Secret da Internal Integration do Sentry; assina o
# webhook de alertas críticos → aviso no sino do Admin (docs/notificacoes.md §8b).
SENTRY_WEBHOOK_SECRET=
# Local: 1 liga o envio em development para testar a integração.
NEXT_PUBLIC_SENTRY_DEV=

# Firebase Cloud Messaging (Web Push). A VAPID key é pública; o padrão está em
# lib/notificacoes-push.ts e esta variável só é necessária se o par for trocado.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# App Web do Firebase (Configurações do projeto → Seus apps → Web). Valores
# PÚBLICOS: vão para o navegador de qualquer jeito. Sem eles, o push fica
# "indisponível neste ambiente" e as notificações continuam no sino.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Conta de serviço do Firebase — SECRETA, só no servidor (Vercel: sensitive).
# Nunca com prefixo NEXT_PUBLIC_, nunca no código. Use o JSON inteiro OU as
# três variáveis separadas (a chave pode ter "\n" literais).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Segredo (24+ caracteres) que o banco usa para acordar o envio de push em
# /api/notificacoes/processar. O mesmo valor vai no Supabase Vault
# (notificacoes_segredo). Ver docs/notificacoes.md §8.
NOTIFICACOES_SEGREDO=
